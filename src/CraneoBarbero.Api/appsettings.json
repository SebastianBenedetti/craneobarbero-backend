{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "RootCertificatePath": "certs/supabase-root-2021.crt"
  },
  "Jwt": {
    "Issuer": "craneobarbero-api",
    "Audience": "craneobarbero-frontend",
    "ExpirationMinutes": 1440
  },
  "Security": {
    "MaxRequestBodyBytes": 1048576,
    "GlobalRateLimit": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "AuthRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Schedule": {
    "JobsEnabled": true,
    "HolidaysApiUrl": "https://api.argentinadatos.com/v1/feriados/",
    "HolidaysApiTimeoutSeconds": 20,
    "HolidaySyncIntervalDays": 7,
    "DailyGenerationTime": "00:30",
    "PastSlotRetentionDays": 90
  },
  "Pricing": {
    "IndecApiUrl": "https://apis.datos.gob.ar/series/api/",
    "IndecSeriesId": "148.3_INIVELNAL_DICI_M_26",
    "FallbackApiUrl": "https://api.argentinadatos.com/v1/finanzas/indices/inflacion",
    "TimeoutSeconds": 15,
    "CacheHours": 12
  },
  "Business": {
    "TimeZone": "America/Argentina/Buenos_Aires",
    "Currency": "ARS",
    "SlotMinutes": 30,
    "CancellationWindowHours": 4,
    "PaymentExpirationMinutes": 30,
    "BookingWindowDays": 60,
    "SlotGenerationMonths": 12,
    "PaymentMethods": [ "cash", "card", "transfer", "wallet", "mercadopago" ],
    "OpeningHours": {
      "Monday": [
        { "Start": "09:00", "End": "13:00" },
        { "Start": "15:00", "End": "20:00" }
      ],
      "Tuesday": [
        { "Start": "09:00", "End": "13:00" },
        { "Start": "15:00", "End": "20:00" }
      ],
      "Wednesday": [
        { "Start": "09:00", "End": "13:00" },
        { "Start": "15:00", "End": "20:00" }
      ],
      "Thursday": [
        { "Start": "09:00", "End": "13:00" },
        { "Start": "15:00", "End": "20:00" }
      ],
      "Friday": [
        { "Start": "09:00", "End": "13:00" },
        { "Start": "15:00", "End": "20:00" }
      ],
      "Saturday": [
        { "Start": "09:00", "End": "15:00" }
      ]
    }
  }
}
